{
  "name": "Growth OS - Daily Opportunity Discovery",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "hours", "hoursInterval": 24}] }},
      "id": "schedule",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-700, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.GROWTH_OS_API_URL + '/api/v1/jobs/discover'}}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{'Bearer ' + $env.GROWTH_OS_USER_JWT}}"}, {"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"remote_only\":true,\"max_age_hours\":24,\"min_match_score\":55,\"limit\":100,\"roles\":[\"Full-Stack Developer\",\"React Developer\",\"Next.js Developer\",\"MERN Developer\",\"AI Engineer\",\"AI Agent Developer\",\"Automation Developer\"]}",
        "options": {"timeout": 120000}
      },
      "id": "jobs",
      "name": "Discover Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-420, -120],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.GROWTH_OS_API_URL + '/api/v1/leads/discover'}}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{'Bearer ' + $env.GROWTH_OS_USER_JWT}}"}, {"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"query\":\"startups, agencies and businesses with active software, AI or automation needs\",\"limit\":30}",
        "options": {"timeout": 120000}
      },
      "id": "leads",
      "name": "Discover Client Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-420, 120],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.GROWTH_OS_API_URL + '/api/v1/command'}}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "={{'Bearer ' + $env.GROWTH_OS_USER_JWT}}"}, {"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"command\":\"Summarize today's strongest job and client opportunities and tell me what to review first.\",\"context\":{}}",
        "options": {"timeout": 120000}
      },
      "id": "summary",
      "name": "Daily Priority Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-80, 0]
    }
  ],
  "connections": {
    "Daily Schedule": {"main": [[{"node": "Discover Jobs", "type": "main", "index": 0}, {"node": "Discover Client Leads", "type": "main", "index": 0}]]},
    "Discover Jobs": {"main": [[{"node": "Daily Priority Summary", "type": "main", "index": 0}]]},
    "Discover Client Leads": {"main": [[{"node": "Daily Priority Summary", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "active": false,
  "versionId": "00000000-0000-4000-8000-000000000001"
}
